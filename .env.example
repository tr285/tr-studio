# ==============================================================================
# TR STUDIO — Environment Configuration Example
# Copy this file to .env (`cp .env.example .env`) before starting services.
# Never commit real secrets to version control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
APP_NAME="TR STUDIO"
APP_VERSION="0.2.0"
DEBUG=true

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Security & JWT Authentication
# Generate a strong secret for production: `openssl rand -hex 32`
SECRET_KEY=replace_with_a_secure_64_character_hex_secret_key_for_jwt_signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Configuration
POSTGRES_USER=trstudio
POSTGRES_PASSWORD=trstudio_dev_password_change_me
POSTGRES_DB=trstudio_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://trstudio:trstudio_dev_password_change_me@localhost:5432/trstudio_db

# Redis Configuration (Prepared for future background jobs & rendering queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# AI Story Creation Engine Configuration (Step 2)
# Supported AI_PROVIDER values: gemini | openai | openai_compatible
# Leave AI_API_KEY empty to test honest missing-credentials behavior while
# keeping full manual story creation, screenplay editing, and versioning enabled.
# ==============================================================================
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_TIMEOUT_SECONDS=90

# ==============================================================================
# AI Character & Environment Creation Studios — Image Generation & Storage (Steps 3 & 4)
# Supported IMAGE_PROVIDER values: gemini | openai | openai_compatible
# Leave IMAGE_API_KEY empty to test honest missing-credentials behavior while
# keeping manual character/environment creation, World Hierarchy, and uploads active.
# ==============================================================================
IMAGE_PROVIDER=gemini
IMAGE_API_KEY=
IMAGE_MODEL=imagen-3.0-generate-002
IMAGE_BASE_URL=
IMAGE_TIMEOUT_SECONDS=90

# Secure Character Asset Storage (local | s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
SIGNED_URL_EXPIRE_SECONDS=3600
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# ==============================================================================
# AI Dialogue, Voice & Audio Studio (Step 8)
# Supported VOICE_PROVIDER values: google | elevenlabs | mock
# Leave VOICE_API_KEY empty to test honest 503 missing-credentials behavior
# while manual dialogue editing, narration, and audio uploads remain functional.
# ==============================================================================
VOICE_PROVIDER=google
VOICE_API_KEY=
VOICE_MODEL=en-US-Neural2-F
VOICE_BASE_URL=
VOICE_TIMEOUT_SECONDS=60
MAX_AUDIO_UPLOAD_SIZE_MB=50

# Frontend Public Environment Variables
NEXT_PUBLIC_APP_NAME="TR STUDIO"
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_URL=http://localhost:8000/api/v1
