# ==============================================================================
# TR STUDIO — Environment Configuration Example
# Copy this file to .env (`cp .env.example .env`) before starting services.
# Never commit real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME="TR STUDIO"
APP_VERSION="1.0.0"
DEBUG=true

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret for production: `openssl rand -hex 32`
SECRET_KEY=replace_with_a_secure_64_character_hex_secret_key_for_jwt_signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated list of allowed origins)
# In production, include your frontend domain: e.g. https://trstudio.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=trstudio
POSTGRES_PASSWORD=trstudio_dev_password_change_me
POSTGRES_DB=trstudio_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://trstudio:trstudio_dev_password_change_me@localhost:5432/trstudio_db
DATABASE_URL_UNPOOLED=

# ------------------------------------------------------------------------------
# 4. Redis Configuration (Background Jobs & Queues)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. Google Gemini AI Story Creation Engine Configuration
# ------------------------------------------------------------------------------
# Supported AI_PROVIDER values: gemini | openai | openai_compatible
# Obtain a free Google Gemini key at: https://aistudio.google.com/
# Leave AI_API_KEY empty to test honest missing-credentials behavior while
# keeping full manual story creation, screenplay editing, and versioning enabled.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_RETRIES=3
AI_RETRY_DELAY_SECONDS=2.0
AI_USER_RATE_LIMIT_PER_MINUTE=15

# ------------------------------------------------------------------------------
# 6. AI Character & Environment Studios — Image Generation (Optional)
# ------------------------------------------------------------------------------
# Supported IMAGE_PROVIDER values: gemini | openai | openai_compatible
IMAGE_PROVIDER=gemini
IMAGE_API_KEY=
IMAGE_MODEL=imagen-3.0-generate-002
IMAGE_BASE_URL=
IMAGE_TIMEOUT_SECONDS=90

# Character & Environment Asset Storage (local | s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
SIGNED_URL_EXPIRE_SECONDS=3600
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# 7. AI Voice & Audio Studio Configuration (Optional)
# ------------------------------------------------------------------------------
# Supported VOICE_PROVIDER values: google | elevenlabs | mock
VOICE_PROVIDER=google
VOICE_API_KEY=
VOICE_MODEL=en-US-Neural2-F
VOICE_BASE_URL=
VOICE_TIMEOUT_SECONDS=60
MAX_AUDIO_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# 8. Frontend Public Environment Variables (Only NEXT_PUBLIC_* exposed to browser)
# ------------------------------------------------------------------------------
# WARNING: NEVER put AI_API_KEY, SECRET_KEY, or database credentials here!
NEXT_PUBLIC_APP_NAME="TR STUDIO"
# In local development: http://localhost:8000
# In production: https://api.yourdomain.com (deployed FastAPI backend URL)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_NEON_AUTH_URL=
